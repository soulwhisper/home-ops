{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Track annotated CI tool versions",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)[ \\t]*\\r?\\n[ \\t]*[A-Z][A-Z0-9_]*=\"(?<currentValue>[^\"\\s]+)\"",
      ],
    },
  ],
  packageRules: [
    {
      matchDatasources: ["python-version"],
      enabled: false,
    },
  ],
}
