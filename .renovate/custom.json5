{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customDatasources: {
    "immich-machine-learning": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/immich-app/immich/releases?per_page=100",
      format: "json",
      transformTemplates: [
        '{"releases": $map($filter($, function($release) { $not($release.draft) and $not($release.prerelease) }), function($release) { {"version": $release.tag_name & "-openvino", "releaseTimestamp": $release.published_at} })}',
      ],
    },
  },
  customManagers: [
    {
      customType: "regex",
      description: "Process custom images and version fields",
      fileMatch: ["(^|/).+\\.yaml$"],
      matchStrings: [
        // image: <registry>/<path>:vX.Y.Z   (e.g. 10-general.yaml)
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+packageName=(?<packageName>[^\\s]+))?\\s+image:\\s*(?<depPart>.*?:)(?<currentValue>[v\\d\\.]+)",
        // version: vX.Y.Z                   (e.g. system-upgrade-controller plans)
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+packageName=(?<packageName>[^\\s]+))?\\s+[a-z0-9_]*version:\\s*(?<currentValue>[v\\d\\.]+)",
      ],
      datasourceTemplate: "{{{datasource}}}",
      depNameTemplate: "{{{depName}}}",
    },
    {
      customType: "regex",
      description: "Process Helmfile oci charts",
      fileMatch: ["(^|/)helmfile\\.yaml$"],
      matchStrings: [
        "chart: oci://(?<depName>[^\\s]+?)\\s+version: (?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "helm",
    },
  ],
  packageRules: [
    {
      matchDatasources: ["python-version"],
      enabled: false,
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ["before 4am on Monday"],
  },
}
