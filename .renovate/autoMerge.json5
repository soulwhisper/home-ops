{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Disable digest pinning for all Docker references",
      matchDatasources: ["docker"],
      pinDigests: false,
    },
    // platformAutomerge is on on purpose
    {
      description: "Auto-merge patch updates after CI",
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions updates after CI",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: false,
    },
    {
      description: "Frequent quiet-train apps: auto-merge minor updates after CI",
      matchPackageNames: [
        "ghcr.io/kimdre/doco-cd",
        "ghcr.io/starosdev/scrutiny",
        "ghcr.io/open-telemetry/opentelemetry-helm-charts/opentelemetry-collector",
      ],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: "User apps: auto-merge minor updates after CI",
      matchFileNames: [
        "kubernetes/apps/selfhosted-apps/**",
        "kubernetes/apps/servitor-apps/**",
        "kubernetes/apps/smarthome-apps/**",
      ],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: "Infra apps: minor require manual merge",
      matchFileNames: [
        "kubernetes/apps/kube-system/**",
        "kubernetes/apps/gitops-system/**",
        "kubernetes/apps/security-system/**",
        "kubernetes/apps/database-system/**",
        "kubernetes/apps/storage-system/**",
        "kubernetes/apps/networking-system/**",
        "kubernetes/apps/monitoring-system/**",
        "infrastructure/**",
      ],
      matchUpdateTypes: ["minor"],
      automerge: false,
      addLabels: ["review/required"],
    },
    {
      description: "Global: major updates always require manual merge",
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["review/required"],
    },
    {
      description: "Kubernetes, Talos, and sensitive app updates require human review",
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet",
        "siderolabs/talos",
        "ghcr.io/soulwhisper/covel",
        "ghcr.io/diceframe/diceframe",
        "ghcr.io/open-webui/open-webui",
      ],
      automerge: false,
      platformAutomerge: false,
      reviewers: ["soulwhisper"],
      addLabels: ["review/required"],
    },
    {
      description: "Keep disruptive controller updates out of automatic rollout waves",
      matchFileNames: [
        "kubernetes/apps/kube-system/cilium/**",
        "kubernetes/apps/gitops-system/system-upgrade-controller/**",
        "kubernetes/apps/database-system/cnpg-operator/**",
        "kubernetes/apps/storage-system/kopiur/**",
        "kubernetes/apps/storage-system/rook-ceph/**",
      ],
      matchUpdateTypes: ["patch", "minor", "major"],
      automerge: false,
      platformAutomerge: false,
      reviewers: ["soulwhisper"],
      addLabels: ["review/required"],
    },
  ],
}
