{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Disable digest pinning for all Docker references",
      matchDatasources: ["docker"],
      pinDigests: false,
    },
    // platformAutomerge is off on purpose: GitHub-native automerge merged 4-5
    // PRs within a minute once CI passed together (2026-10-08 18:11Z,
    // 10-09 00:04Z); the resulting image-pull wave stalled etcd fsync and
    // caused ~20 controller leader-election restarts. Renovate-side automerge
    // merges at most one branch per run, spacing rollouts out.
    {
      description: "Auto-merge patch updates after CI",
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions updates after CI",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: false,
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: false,
    },
    {
      description: "User apps: auto-merge minor updates after CI",
      matchFileNames: [
        "kubernetes/apps/gaming-apps/**",
        "kubernetes/apps/media-apps/**",
        "kubernetes/apps/selfhosted-apps/**",
        "kubernetes/apps/servitor-apps/**",
        "kubernetes/apps/smarthome-apps/**",
      ],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: "Infra apps: minor require manual merge",
      matchFileNames: [
        "kubernetes/apps/kube-system/**",
        "kubernetes/apps/gitops-system/**",
        "kubernetes/apps/security-system/**",
        "kubernetes/apps/database-system/**",
        "kubernetes/apps/storage-system/**",
        "kubernetes/apps/networking-system/**",
        "kubernetes/apps/monitoring-system/**",
        "infrastructure/**",
      ],
      matchUpdateTypes: ["minor"],
      automerge: false,
      addLabels: ["review/required"],
    },
    {
      description: "Frequent quiet-train apps: auto-merge minor updates after CI",
      matchPackageNames: [
        "ghcr.io/langfuse/langfuse",
        "ghcr.io/langfuse/langfuse-worker",
        "ghcr.io/kimdre/doco-cd",
        "ghcr.io/starosdev/scrutiny",
      ],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: "Global: major updates always require manual merge",
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["review/required"],
    },
  ],
}
