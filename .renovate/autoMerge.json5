{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Disable digest pinning for all Docker references",
      matchDatasources: ["docker"],
      pinDigests: false,
    },
    // platformAutomerge is on on purpose
    {
      description: "Auto-merge patch updates after CI",
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions updates after CI",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: false,
    },
    {
      description: "Infrastructure minor updates require manual merge",
      matchFileNames: ["infrastructure/**"],
      matchUpdateTypes: ["minor"],
      automerge: false,
      addLabels: ["review/required"],
    },
    {
      description: "Global: major updates always require manual merge",
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["review/required"],
    },
  ],
}
