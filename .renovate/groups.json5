{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "AgentGateway Group",
      groupName: "AgentGateway",
      matchDatasources: ["docker"],
      matchPackageNames: ["/agentgateway/", "/agentgateway-crds/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
      allowedVersions: "/^1\\./",
    },
    {
      description: "1Password Connect Group",
      groupName: "1Password Connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/connect-api/", "/connect-sync/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "KGateway Group",
      groupName: "KGateway",
      matchDatasources: ["docker"],
      matchPackageNames: ["/kgateway-crds/", "/kgateway/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Rook Ceph Group",
      groupName: "Rook Ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Victoria Metrics Group",
      groupName: "Victoria Metrics",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/victoria-metrics-k8s-stack/",
        "/victoria-metrics-operator-crds/",
        "/victoria-metrics-operator/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Toolhive Group (operator and CRDs share a release)",
      groupName: "Toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Firecrawl Group (core image and MCP server)",
      groupName: "Firecrawl",
      matchDatasources: ["docker"],
      matchPackageNames: ["/firecrawl/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Dragonfly Group (image and operator chart)",
      groupName: "Dragonfly",
      matchPackageNames: ["/dragonfly/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Victoria Logs and Traces Group",
      groupName: "Victoria Logs/Traces",
      matchDatasources: ["docker"],
      matchPackageNames: ["/victoria-logs/", "/victoria-traces/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
  ],
}
