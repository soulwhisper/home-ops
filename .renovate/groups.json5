{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "AgentGateway Group",
      groupName: "AgentGateway",
      matchDatasources: ["docker"],
      matchPackageNames: ["/agentgateway/", "/agentgateway-crds/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
      allowedVersions: "/^1\\./",
    },
    {
      description: "1Password Connect Group",
      groupName: "1Password Connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/connect-api/", "/connect-sync/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "KGateway Group",
      groupName: "KGateway",
      matchDatasources: ["docker"],
      matchPackageNames: ["/kgateway-crds/", "/kgateway/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Immich Group (server and machine-learning resolve via GitHub releases)",
      groupName: "Immich",
      matchDatasources: ["docker", "github-releases", "custom.immich-machine-learning"],
      matchPackageNames: ["/immich-server/", "/immich-machine-learning/", "immich-app/immich"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Langfuse Group",
      groupName: "Langfuse",
      matchDatasources: ["docker"],
      matchPackageNames: ["/langfuse/", "/langfuse-worker/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Rook Ceph Group",
      groupName: "Rook Ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Victoria Metrics Group",
      groupName: "Victoria Metrics",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/victoria-metrics-k8s-stack/",
        "/victoria-metrics-operator-crds/",
        "/victoria-metrics-operator/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Toolhive Group (operator and CRDs share a release)",
      groupName: "Toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "ClickHouse Group (server, keeper, and operator)",
      groupName: "ClickHouse",
      matchPackageNames: ["/clickhouse/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Firecrawl Group (core image and MCP server)",
      groupName: "Firecrawl",
      matchDatasources: ["docker"],
      matchPackageNames: ["/firecrawl/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Dragonfly Group (image, operator chart, and vendir source)",
      groupName: "Dragonfly",
      matchPackageNames: ["/dragonfly/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Victoria Logs and Traces Group",
      groupName: "Victoria Logs/Traces",
      matchDatasources: ["docker"],
      matchPackageNames: ["/victoria-logs/", "/victoria-traces/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
  ],
}
