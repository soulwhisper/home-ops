{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Block intel-device-plugins-operator 0.37.x: invalid MutatingWebhookConfiguration (missing sideEffects/clientConfig/admissionReviewVersions) rejected by server-side apply; revisit on 0.38.x",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/intel/helm-charts/intel-device-plugins-operator"],
      allowedVersions: "!/^0\\.37\\..*$/",
    },
    {
      description: "Pin Postgres version to 18",
      matchDatasources: ["docker"],
      matchPackagePatterns: [
        "ghcr.io/home-operations/postgres-init",
        "ghcr.io/tensorchord/cloudnative-vectorchord",
        "prodrigestivill/postgres-backup-local",
      ],
      allowedVersions: "18",
    },
    {
      description: "Separate talos and kubelet versions",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/kubelet",
      ],
      separateMajorMinor: true,
      separateMinorPatch: true,
    },
    {
      description: "ghcr tag-list rate limits (31k+ tags, v3.3.0 on last page): look up immich-server via GitHub releases. machine-learning stays on docker: its -openvino suffix only exists as a ghcr tag",
      matchPackageNames: ["ghcr.io/immich-app/immich-server"],
      overrideDatasource: "github-releases",
      overridePackageName: "immich-app/immich",
    },
  ],
}
