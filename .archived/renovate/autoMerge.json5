{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "User apps and standalone exporters: auto-merge minor updates after CI",
      matchFileNames: [
        "kubernetes/apps/selfhosted-apps/**",
        "kubernetes/apps/servitor-apps/**",
        "kubernetes/apps/smarthome-apps/**",
        "kubernetes/apps/monitoring-system/blackbox-exporter/**",
        "kubernetes/apps/monitoring-system/kube-state-metrics/**",
        "kubernetes/apps/monitoring-system/node-exporter/**",
        "kubernetes/apps/monitoring-system/smartctl-exporter/**",
      ],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: "Infra apps: minor require manual merge",
      matchFileNames: [
        "kubernetes/apps/kube-system/**",
        "kubernetes/apps/gitops-system/**",
        "kubernetes/apps/security-system/**",
        "kubernetes/apps/database-system/**",
        "kubernetes/apps/storage-system/**",
        "kubernetes/apps/networking-system/**",
        "kubernetes/apps/monitoring-system/**",
        "!kubernetes/apps/monitoring-system/blackbox-exporter/**",
        "!kubernetes/apps/monitoring-system/kube-state-metrics/**",
        "!kubernetes/apps/monitoring-system/node-exporter/**",
        "!kubernetes/apps/monitoring-system/smartctl-exporter/**",
      ],
      matchUpdateTypes: ["minor"],
      automerge: false,
      addLabels: ["review/required"],
    },
    {
      description: "Kubernetes, Talos, and sensitive app updates require human review",
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet",
        "siderolabs/talos",
        "ghcr.io/soulwhisper/covel",
        "ghcr.io/diceframe/diceframe",
        "ghcr.io/open-webui/open-webui",
      ],
      automerge: false,
      platformAutomerge: false,
      reviewers: ["soulwhisper"],
      addLabels: ["review/required"],
    },
    {
      description: "Keep disruptive controller updates out of automatic rollout waves",
      matchFileNames: [
        "kubernetes/apps/kube-system/cilium/**",
        "kubernetes/apps/gitops-system/system-upgrade-controller/**",
        "kubernetes/apps/database-system/cnpg-operator/**",
        "kubernetes/apps/storage-system/kopiur/**",
        "kubernetes/apps/storage-system/rook-ceph/**",
      ],
      matchUpdateTypes: ["patch", "minor", "major"],
      automerge: false,
      platformAutomerge: false,
      reviewers: ["soulwhisper"],
      addLabels: ["review/required"],
    },
  ],
}
