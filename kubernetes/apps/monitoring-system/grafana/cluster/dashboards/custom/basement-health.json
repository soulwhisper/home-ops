        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0.995,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.998
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 5,
      "links": [
        {
          "title": "API Server drilldown",
          "url": "/d/k8s_system_apisrv"
        },
        {
          "title": "Investigate in Explore",
          "url": "/explore?left=%7B%22datasource%22%3A%22victoria-metrics%22%2C%22queries%22%3A%5B%7B%22expr%22%3A%221%20-%20%28sum%28increase%28apiserver_request_total%7Bcode%3D~%5C%225..%5C%22%7D%5B30d%5D%29%29%20or%20vector%280%29%29%20%2F%20sum%28increase%28apiserver_request_total%5B30d%5D%29%29%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-24h%22%2C%22to%22%3A%22now%22%7D%7D"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
