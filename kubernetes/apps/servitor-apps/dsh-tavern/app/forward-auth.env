# Policy for this DSH image. These are static deployment policy, not
# runtime-fetchable Authentik data: homelab-admin is a group (user admin is its
# member), and x-authentik-groups is forwarded by the kgateway ext-auth.
# If the user joins additional groups, switch to x-authentik-uid/username.
DSH_FORWARD_AUTH_HEADER=x-authentik-groups
DSH_FORWARD_AUTH_ALLOWED_SUBJECTS=homelab-admin
DSH_FORWARD_AUTH_TRUSTED_PROXY_CIDRS=10.100.0.0/17
DSH_FORWARD_AUTH_MAX_CONNECTION_SECONDS=900
