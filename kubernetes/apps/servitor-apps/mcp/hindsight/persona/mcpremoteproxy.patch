---
- op: replace
  path: /metadata/name
  value: mcp-hindsight-persona
- op: add
  path: /spec/groupRef
  value:
    name: persona
- op: add
  path: /spec/toolConfigRef
  value:
    name: mcp-hindsight-persona
# Persona bank (renamed from the legacy home bank). Hindsight creates a bank
# on first retain; reads (get_bank, list_tags, recall) require it to exist.
# Cut over only after the bank is aliased/renamed; 404s before that are a
# migration signal, not a healthy empty bank.
- op: add
  path: /spec/remoteUrl
  value: http://hindsight.selfhosted-apps.svc.cluster.local:8888/mcp/persona
