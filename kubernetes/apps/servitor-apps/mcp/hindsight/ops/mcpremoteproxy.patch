---
- op: replace
  path: /metadata/name
  value: mcp-hindsight-ops
- op: add
  path: /spec/groupRef
  value:
    # operator-agent tier (virtualmcpserver/agent via agentgateway /mcp/agent) —
    # chat-tier consumers on search/cluster/persona can never retain into
    # incident memory
    name: agent
- op: add
  path: /spec/toolConfigRef
  value:
    name: mcp-hindsight-ops
# dedicated memory bank for ai-ops incident/RCA memory — recall boundary
# keeps ops history out of conversational banks.
# Hindsight creates the bank on first retain; reads require it to exist.
- op: add
  path: /spec/remoteUrl
  value: http://10.10.0.100:8888/mcp/ops
