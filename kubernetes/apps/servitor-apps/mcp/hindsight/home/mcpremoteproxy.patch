---
- op: replace
  path: /metadata/name
  value: mcp-hindsight-home
- op: add
  path: /spec/groupRef
  value:
    name: home
- op: add
  path: /spec/toolConfigRef
  value:
    name: mcp-hindsight-home
# Hindsight creates the bank on first retain; reads (get_bank, list_tags,
# recall) require it to exist. This single-bank endpoint is valid; 404s
# before the first retain are expected.
- op: add
  path: /spec/remoteUrl
  value: http://hindsight.selfhosted-apps.svc.cluster.local:8888/mcp/home
