---
- op: replace
  path: /metadata/name
  value: mcp-hindsight-home
- op: add
  path: /spec/groupRef
  value:
    name: persona
- op: add
  path: /spec/toolConfigRef
  value:
    name: mcp-hindsight-home
# Existing home bank; it coexists with the separate persona bank. Hindsight
# creates banks on first retain; reads require them to exist.
- op: add
  path: /spec/remoteUrl
  value: http://hindsight.selfhosted-apps.svc.cluster.local:8888/mcp/home
