---
- op: replace
  path: /metadata/name
  value: mcp-hindsight-work
- op: add
  path: /spec/groupRef
  value:
    name: persona
- op: add
  path: /spec/toolConfigRef
  value:
    name: mcp-hindsight-work
# Project/work memory is not persona memory. Hindsight creates the bank on
# first retain; reads require it to exist.
- op: add
  path: /spec/remoteUrl
  value: http://hindsight.selfhosted-apps.svc.cluster.local:8888/mcp/work
