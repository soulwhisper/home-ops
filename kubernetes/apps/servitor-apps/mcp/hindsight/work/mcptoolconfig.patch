---
- op: replace
  path: /metadata/name
  value: mcp-hindsight-work
- op: add
  path: /spec/toolsOverride
  value:
    retain:
      description: >-
        Store derived project/work memory (decisions, runbooks, task context).
        Do not store private persona facts, credentials, raw tool outputs, or
        verbatim logs. Tag consistently using existing tags (see list_tags).
    recall:
      description: >-
        Search work memories. Prefer reflect for synthesized answers; use
        recall only when individual memory entries are needed.
